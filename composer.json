{
    "name": "koh/structured-content",
    "description": "Schema.org JSON-LD generation, AI-context annotations, and content-relationship management for TYPO3. Owns the full Schema.org generator stack (Article/WebPage/FAQ/Service/Product/Organization/...) plus audience/tone/channel inheritance and typed cross-content relationships.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "homepage": "https://ole-hartwig.eu/open-source/structured-content",
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu",
            "homepage": "https://ole-hartwig.eu",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ohartwig/structured-content/issues",
        "source": "https://github.com/ohartwig/structured-content",
        "security": "https://github.com/ohartwig/structured-content/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.5.11",
        "typo3/cms-backend": "^14.0",
        "typo3/cms-core": "^14.0",
        "typo3/cms-frontend": "^14.0"
    },
    "require-dev": {
        "koh/dev-typo3": "^1.0"
    },
    "suggest": {
        "moselwal/content-blocks-collection": "Liefert den Record-Type `moselwal_person` — Voraussetzung fuer das Seitenfeld `tx_structuredcontent_author_records` und die Person-/ProfilePage-Schema-Generatoren"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/175/-/packages/composer/packages.json",
            "only": [
                "hn/typo3-mcp-server",
                "netresearch/nr-passkeys-be"
            ]
        },
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Koh\\StructuredContent\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\StructuredContent\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "structured_content"
        }
    },
    "scripts": {
        "deptrac": "deptrac analyse",
        "phpstan": "phpstan analyse",
        "test": "phpunit -c Tests/phpunit.xml --testsuite Unit"
    }
}
